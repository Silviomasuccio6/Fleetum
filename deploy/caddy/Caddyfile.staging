{
	email {$CADDY_EMAIL}
}

(security_headers) {
	header {
		X-Content-Type-Options "nosniff"
		X-Robots-Tag "noindex, nofollow, noarchive"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Baseline only: Next export inline hydration scripts still need build-linked hashes.
		# Append so stricter upstream policies (Helmet) also remain enforced.
		+Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'"
		-Server
		defer
	}
}

(staging_discovery) {
	route /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond 200 {
			body <<ROBOTS
User-agent: *
Disallow: /
ROBOTS
		}
	}
	@staging_sitemaps path /sitemap.xml /sitemap-*.xml
	route @staging_sitemaps {
		respond 404
	}
}

(staging_errors) {
	handle_errors {
		import security_headers
		respond "Staging request failed" {err.status_code}
	}
}

staging.fleetum.it {
	import security_headers
	import staging_errors
	route {
		import staging_discovery
		encode zstd gzip
		handle /api/* {
			reverse_proxy backend:4000
		}

		@legacy_software_autonoleggio path /software-autonoleggio /software-autonoleggio/*
		redir @legacy_software_autonoleggio /prodotto 308

		@legacy_software_rent_a_car path /software-rent-a-car /software-rent-a-car/*
		redir @legacy_software_rent_a_car /soluzioni 308

		@legacy_contracts path /contratti-noleggio-digitali /contratti-noleggio-digitali/*
		redir @legacy_contracts /contratti-digitali 308

		@legacy_profitability path /report-redditivita-veicolo /report-redditivita-veicolo/*
		redir @legacy_profitability /gestionale-flotta 308

		@website_assets path /_next/*
		handle @website_assets {
			root * /srv/fleetum-website
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		handle /brand/* {
			root * /srv/fleetum
			header Cache-Control "public, max-age=86400"
			file_server
		}

		handle /assets/* {
			root * /srv/fleetum
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		@marketing {
			path / /accesso /accesso/* /booking-noleggi /booking-noleggi/* /chi-siamo /chi-siamo/* /come-funziona /come-funziona/* /contratti-digitali /contratti-digitali/* /cookie /cookie/* /demo /demo/* /dpa /dpa/* /gestionale-flotta /gestionale-flotta/* /moduli /moduli/* /prezzi /prezzi/* /privacy /privacy/* /prodotto /prodotto/* /scadenze-manutenzione /scadenze-manutenzione/* /sicurezza /sicurezza/* /soluzioni /soluzioni/* /termini /termini/* /tour /tour/* /llms.txt
		}
		handle @marketing {
			root * /srv/fleetum-website
			try_files {path} {path}/index.html /404.html
			file_server
		}

		# Authenticated tenant routes retain the SPA shell, as in production.
		handle {
			root * /srv/fleetum
			try_files {path} /spa.html
			file_server
		}
	}
}

api-staging.fleetum.it {
	import security_headers
	import staging_errors
	route {
		import staging_discovery
		encode zstd gzip
		@api path /api/*
		reverse_proxy @api backend:4000
		respond "Fleetum Staging API" 200
	}
}

platform-staging.fleetum.it {
	import security_headers
	import staging_errors
	route {
		import staging_discovery
		encode zstd gzip
		@platform_api path /platform-api/*
		reverse_proxy @platform_api backend:4100
		root * /srv/fleetum
		try_files {path} /platform.html
		file_server
	}
}
