# TLS and certificate renewal belong only to the existing public Caddy.
# Client-supplied forwarding headers must never cross this trust boundary.
staging.fleetum.it, api-staging.fleetum.it, platform-staging.fleetum.it {
	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
		-Server
		defer
	}
	reverse_proxy fleetum-staging-ingress:80 {
		header_up Host {host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_up -Forwarded
		header_up -X-Real-IP
		header_up -X-Forwarded-Port
		header_up -X-Forwarded-Server
		header_up -X-Forwarded-Prefix
	}
	handle_errors {
		header {
			X-Robots-Tag "noindex, nofollow, noarchive"
			-Server
		}
		respond "Staging ingress request failed" {err.status_code}
	}
}

# Existing named production sites still take precedence. A TLS request whose
# Host is outside the explicit site allowlist must not fall through with 200.
:443 {
	header X-Robots-Tag "noindex, nofollow, noarchive"
	respond "Unknown Fleetum host" 421
}
