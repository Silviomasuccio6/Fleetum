+        receipts.set(input.idempotencyKey,id);
+      } if(attempts++===0)
+        throw Error("synthetic lost provider reply"); return { provider: "resend",id };
+    }
+  } as any);
+  await worker.processPending(now);
+  await worker.processPending(new Date(now.getTime()+180000));
